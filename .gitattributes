# Line-ending policy for voice-stt repository.
# Windows scripts use CRLF; shell scripts use LF; everything else auto.

# Windows scripting files -- CRLF
*.ahk   text eol=crlf
*.ps1   text eol=crlf

# Shell scripts -- LF
*.sh    text eol=lf

# Python -- LF
*.py    text eol=lf

# Markup / config -- auto (LF on Unix, CRLF on Windows checkout)
*.md    text
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf

# Binaries -- no diff, no line-ending conversion
*.dll   binary
*.png   binary
*.jpg   binary
