# =========================================
# voice-stt Windows-client configuration.
# Copy to .env (installer does this for you) and edit the REQUIRED values.
# .env is gitignored; never commit real secrets/hostnames.
#
# This file only contains variables the Windows client reads. Server-side
# knobs (FunASR, VAD, LLM polish, hotwords, HuggingFace mirror, etc.) live
# on the GPU host — see server/README.md.
# =========================================


# ---------- REQUIRED ----------

# WebSocket URL of your FunASR streaming server (Shift+Alt+S, primary path).
# Example: ws://192.168.1.50:8082/                       (LAN IP)
#       or ws://gpu-tower.your-tailnet.ts.net:8082/     (Tailscale name)
ASR_WS_URL=ws://192.168.1.50:8082/

# Windows mic dshow device name. Discover with:
#   powershell -File windows\record.ps1 -Diagnose
# Copy the exact string (no quotes needed in .env).
RECORD_DEVICE_NAME=


# ---------- OPTIONAL: batch upload (Shift+Alt+V) ----------

# HTTP URL of a Whisper-compatible gateway. Leave empty unless you use the
# batch path. Example: http://gpu-tower:9080
GATEWAY_URL=

# Model / language hints sent with each batch request.
WHISPER_MODEL=large-v3-turbo
WHISPER_LANG=zh
# Note: WHISPER_INITIAL_PROMPT is a server-side gateway knob, not a Windows
# client setting — see server/README.md if you want to bias Whisper output.


# ---------- Recording ----------

# winmm.dll waveIn device ID (-1 = WAVE_MAPPER / default mic; -Diagnose lists them).
RECORD_DEVICE_ID=-1
RECORD_RATE=16000
RECORD_CHANNELS=1
RECORD_BITS=16

# Which channel to capture from a stereo mic. mix = both (default).
# Set left or right if one channel is noisy/silent on your device.
RECORD_MIC_CHANNEL=mix

# Warm-capture daemon ring-buffer length (ms of pre-roll kept before PTT press).
# Lower = less RAM; higher = more forgiving "pressed too late" misses.
# RECORD_WARMUP_SEC=

# Force old MCI path (debug only; modern Win11 drivers usually fail).
USE_MCI=0
USE_WAVEIN=1


# ---------- Debug ----------

# Print PowerShell stderr lines even on success. Default 0.
VERBOSE=0
