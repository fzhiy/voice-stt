# 服务端 docker-compose 读取的环境变量
# 部署时 rsync 推过去；远端 cp .env.server.example .env.server 后修改

# Gateway 对外端口
GATEWAY_PORT=9080

# 宿主机 whisper-server 监听端口
#   8080 = 现有 whisper.cpp small（CPU 2s/11s音频，快）← 当前默认
#   8081 = 新 large-v3-turbo（CPU 7s/11s音频，慢；GPU 版编译后 <0.5s）
WHISPER_PORT=8080
WHISPER_MODEL=small

# Whisper 默认语言：zh / en / auto
WHISPER_LANG=zh

# Ollama 模型（已确认 qwen2.5:7b 性价比最优）
LLM_MODEL=qwen2.5:7b

# ============================================================
# Final-pass ASR (Qwen3-ASR) — pluggable-asr T3
# ============================================================
# See server/README.md "Tuning presets" for the full matrix.
# Defaults (compiled into qwen3_asr.py): 0.6B model + GPU_FRAC=0.5 + max=4096
# — tuned for 12 GB cards shared with other GPU services (frees ~5 GB).
#
# Override examples below — uncomment what you need:

# --- FINAL_BACKEND ---
#   qwen3_asr  = Qwen3-ASR (default)
#   none       = disable Qwen3, use paraformer+ctpunc+polish chain only (saves all vLLM VRAM)
#FINAL_BACKEND=qwen3_asr

# --- Quality preset (1.7B model, needs ≥16 GB card) ---
#QWEN3_ASR_PATH=$HOME/.cache/qwen3-asr-1.7b
#QWEN3_VLLM_GPU_FRAC=0.75

# --- Native long-form preset (single Qwen3 call covers ~160 s) ---
#QWEN3_VLLM_MAX_MODEL_LEN=8192
#QWEN3_VLLM_GPU_FRAC=0.55

# --- Low-resource preset (no vLLM KV pool, slow but tiny) ---
#QWEN3_BACKEND=transformers

# --- Empirical: GPU_FRAC < 0.5 fails on 12 GB with 0.6B + 4096
# vLLM bails "No available memory for the cache blocks" → server falls back
# to transformers (20-50x slower). Do not go below 0.5 unless you also
# switch QWEN3_BACKEND=transformers.

# === Cloud OpenAI-compat backend (optional) ===
# To use a Whisper-compatible HTTP endpoint (openai.com, Groq,
# self-hosted faster-whisper-server, etc.), run:
#     python server/openai-compat-stream-server.py
# Credentials live at:
#     ~/.config/voice-stt/secrets/openai-compat.env
